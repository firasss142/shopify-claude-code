{{ 'section-quraan-how-to-use.css' | asset_url | stylesheet_tag }}

<section
  class="quraan-howto color-{{ section.settings.color_scheme }}"
  style="--quraan-howto-padding-top: {{ section.settings.padding_top }}px; --quraan-howto-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="quraan-howto__inner">
    <header class="quraan-howto__header">
      <h2 class="quraan-howto__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="quraan-howto__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <ol class="quraan-howto__steps" role="list">
      {% for i in (1..3) %}
        {% assign title_key = 'step_' | append: i | append: '_title' %}
        {% assign body_key = 'step_' | append: i | append: '_body' %}
        {% assign image_key = 'step_' | append: i | append: '_image' %}
        {% assign title = section.settings[title_key] %}
        {% assign body = section.settings[body_key] %}
        {% assign image = section.settings[image_key] %}
        {% if title != blank %}
          <li class="quraan-howto__step">
            <div class="quraan-howto__step-media">
              {% if image != blank %}
                {{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: title, class: 'quraan-howto__step-image' }}
              {% else %}
                <div class="quraan-howto__step-number" aria-hidden="true">{{ i }}</div>
              {% endif %}
            </div>
            <div class="quraan-howto__step-content">
              <h3 class="quraan-howto__step-title">{{ title }}</h3>
              <p class="quraan-howto__step-body">{{ body }}</p>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Quraan · كيف تستخدم",
  "tag": "section",
  "class": "quraan-howto-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "كيف تبدأ تلاوتك؟" },
    { "type": "text", "id": "subheading", "label": "وصف قصير", "default": "ثلاث خطوات تجعل لقاءك بكتاب الله أعمق" },
    { "type": "header", "content": "الخطوة 1" },
    { "type": "text", "id": "step_1_title", "label": "العنوان", "default": "تطهَّر" },
    { "type": "textarea", "id": "step_1_body", "label": "الوصف", "default": "ابدأ بالوضوء واستعد بقلبٍ خاشع لاستقبال آيات الله." },
    { "type": "image_picker", "id": "step_1_image", "label": "الصورة" },
    { "type": "header", "content": "الخطوة 2" },
    { "type": "text", "id": "step_2_title", "label": "العنوان", "default": "اجلس بسكينة" },
    { "type": "textarea", "id": "step_2_body", "label": "الوصف", "default": "اختر مكاناً هادئاً، وافتح المصحف بأدبٍ وتعظيم." },
    { "type": "image_picker", "id": "step_2_image", "label": "الصورة" },
    { "type": "header", "content": "الخطوة 3" },
    { "type": "text", "id": "step_3_title", "label": "العنوان", "default": "اتلُ بتدبُّر" },
    { "type": "textarea", "id": "step_3_body", "label": "الوصف", "default": "اقرأ على مهل، وتأمّل المعاني، واعقد العزم على العمل بما قرأت." },
    { "type": "image_picker", "id": "step_3_image", "label": "الصورة" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "نظام الألوان",
      "default": "scheme-3"
    },
    { "type": "range", "id": "padding_top", "label": "هامش علوي", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "هامش سفلي", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    { "name": "Quraan · كيف تستخدم" }
  ]
}
{% endschema %}
