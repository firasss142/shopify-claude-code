{{ 'section-quraan-quotes.css' | asset_url | stylesheet_tag }}

<section
  class="quraan-quotes color-{{ section.settings.color_scheme }}"
  style="--quraan-quotes-padding-top: {{ section.settings.padding_top }}px; --quraan-quotes-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="quraan-quotes__inner">
    <div class="quraan-quotes__stats">
      <h2 class="quraan-quotes__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="quraan-quotes__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <ul class="quraan-quotes__stat-list" role="list">
        {% for i in (1..3) %}
          {% assign value_key = 'stat_' | append: i | append: '_value' %}
          {% assign label_key = 'stat_' | append: i | append: '_label' %}
          {% assign value = section.settings[value_key] %}
          {% assign label = section.settings[label_key] %}
          {% if value != blank %}
            <li class="quraan-quotes__stat">
              <span class="quraan-quotes__stat-value">{{ value }}</span>
              <span class="quraan-quotes__stat-label">{{ label }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <ul class="quraan-quotes__cards" role="list">
      {% for i in (1..3) %}
        {% assign quote_key = 'q_' | append: i | append: '_text' %}
        {% assign name_key = 'q_' | append: i | append: '_name' %}
        {% assign quote = section.settings[quote_key] %}
        {% assign name = section.settings[name_key] %}
        {% if quote != blank %}
          <li class="quraan-quotes__card">
            <span class="quraan-quotes__mark" aria-hidden="true">❝</span>
            <blockquote class="quraan-quotes__text">{{ quote }}</blockquote>
            <cite class="quraan-quotes__name">— {{ name }}</cite>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Quraan · شهادات",
  "tag": "section",
  "class": "quraan-quotes-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "أكثر من 6000 قارئ سعيد" },
    { "type": "textarea", "id": "subheading", "label": "وصف قصير", "default": "ثقة عملائنا هي أعظم وسامٍ نعتزّ به." },

    { "type": "header", "content": "إحصائية 1" },
    { "type": "text", "id": "stat_1_value", "label": "النسبة", "default": "98%" },
    { "type": "text", "id": "stat_1_label", "label": "التسمية", "default": "رضا عن جودة الطباعة منذ أول تصفّح" },
    { "type": "header", "content": "إحصائية 2" },
    { "type": "text", "id": "stat_2_value", "label": "النسبة", "default": "95%" },
    { "type": "text", "id": "stat_2_label", "label": "التسمية", "default": "يثنون على متانة التجليد والورق" },
    { "type": "header", "content": "إحصائية 3" },
    { "type": "text", "id": "stat_3_value", "label": "النسبة", "default": "92%" },
    { "type": "text", "id": "stat_3_label", "label": "التسمية", "default": "يوصون به كهدية في المناسبات" },

    { "type": "header", "content": "شهادة 1" },
    { "type": "textarea", "id": "q_1_text", "label": "النص", "default": "وصلني المصحف بتغليفٍ راقٍ، والورق فاخر، وفعلاً يستحق الاسم. جزاكم الله خيراً." },
    { "type": "text", "id": "q_1_name", "label": "الاسم", "default": "أحمد - طرابلس" },
    { "type": "header", "content": "شهادة 2" },
    { "type": "textarea", "id": "q_2_text", "label": "النص", "default": "أهديت نسخة لوالدتي، وكانت سعيدة جداً بجمال التذهيب على الغلاف." },
    { "type": "text", "id": "q_2_name", "label": "الاسم", "default": "فاطمة - بنغازي" },
    { "type": "header", "content": "شهادة 3" },
    { "type": "textarea", "id": "q_3_text", "label": "النص", "default": "تعاملت معهم بثقة لأن الدفع عند الاستلام، والشحن أسرع مما توقعت." },
    { "type": "text", "id": "q_3_name", "label": "الاسم", "default": "محمد - مصراتة" },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "نظام الألوان",
      "default": "scheme-3"
    },
    { "type": "range", "id": "padding_top", "label": "هامش علوي", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "هامش سفلي", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    { "name": "Quraan · شهادات" }
  ]
}
{% endschema %}
