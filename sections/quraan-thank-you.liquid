{{ 'quraan-rtl.css' | asset_url | stylesheet_tag }}
{{ 'section-quraan-thank-you.css' | asset_url | stylesheet_tag }}

<section
  class="quraan-ty color-{{ section.settings.color_scheme }}"
  style="--quraan-ty-padding-top: {{ section.settings.padding_top }}px; --quraan-ty-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="quraan-ty__inner">
    <div class="quraan-ty__badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <path d="M8 12.5l2.5 2.5L16 9" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <h1 class="quraan-ty__title" data-ty-title>{{ section.settings.title }}</h1>

    {%- if section.settings.subtitle != blank -%}
      <p class="quraan-ty__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="quraan-ty__card">
      <div class="quraan-ty__card-row" data-ty-city-row hidden>
        <span class="quraan-ty__card-label">{{ section.settings.city_label }}</span>
        <span class="quraan-ty__card-value" data-ty-city></span>
      </div>
      <div class="quraan-ty__card-row">
        <span class="quraan-ty__card-label">{{ section.settings.delivery_label }}</span>
        <span class="quraan-ty__card-value">{{ section.settings.delivery_value }}</span>
      </div>
      <div class="quraan-ty__card-row">
        <span class="quraan-ty__card-label">{{ section.settings.payment_label }}</span>
        <span class="quraan-ty__card-value">{{ section.settings.payment_value }}</span>
      </div>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="quraan-ty__note">{{ section.settings.note }}</p>
    {%- endif -%}

    <div class="quraan-ty__actions">
      {%- if section.settings.whatsapp_number != blank -%}
        <a
          class="quraan-ty__whatsapp"
          href="https://wa.me/{{ section.settings.whatsapp_number }}"
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.1-.3.2-.5 0a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3a3 3 0 0 0-.9 2.2c0 1.3 1 2.6 1.1 2.8.1.2 1.9 3 4.7 4.1 1.7.7 2.3.8 3.1.7.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1 0-.1-.2-.2-.4-.3z"/>
          </svg>
          {{ section.settings.whatsapp_label }}
        </a>
      {%- endif -%}

      <a class="quraan-ty__continue" href="{{ section.settings.continue_link | default: routes.root_url }}">
        {{ section.settings.continue_label }}
      </a>
    </div>
  </div>
</section>

<script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var name = (params.get('name') || '').trim();
    var city = (params.get('city') || '').trim();

    if (name) {
      var titleEl = document.querySelector('[data-ty-title]');
      if (titleEl) {
        titleEl.textContent = titleEl.textContent.replace('{name}', name);
        if (titleEl.textContent.indexOf(name) === -1) {
          titleEl.textContent = titleEl.textContent + ' ' + name;
        }
      }
    } else {
      var t = document.querySelector('[data-ty-title]');
      if (t) t.textContent = t.textContent.replace('{name}', '').replace(/\s+/g, ' ').trim();
    }

    if (city) {
      var cityRow = document.querySelector('[data-ty-city-row]');
      var cityVal = document.querySelector('[data-ty-city]');
      if (cityRow && cityVal) {
        cityVal.textContent = city;
        cityRow.hidden = false;
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Quraan · شكراً",
  "tag": "section",
  "class": "quraan-ty-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "استخدم {name} في العنوان ليظهر اسم العميل تلقائياً (يُقرأ من رابط الصفحة)."
    },
    { "type": "text", "id": "title", "label": "العنوان", "default": "شكراً لك {name}، تم استلام طلبك!" },
    { "type": "textarea", "id": "subtitle", "label": "وصف", "default": "طلبك الآن قيد المعالجة. سنتواصل معك هاتفياً لتأكيد التفاصيل." },
    { "type": "text", "id": "city_label", "label": "تسمية المدينة", "default": "مدينة التوصيل" },
    { "type": "text", "id": "delivery_label", "label": "تسمية مدة التوصيل", "default": "مدة التوصيل المتوقعة" },
    { "type": "text", "id": "delivery_value", "label": "مدة التوصيل", "default": "2 - 5 أيام عمل" },
    { "type": "text", "id": "payment_label", "label": "تسمية الدفع", "default": "طريقة الدفع" },
    { "type": "text", "id": "payment_value", "label": "طريقة الدفع", "default": "نقداً عند الاستلام" },
    { "type": "textarea", "id": "note", "label": "ملاحظة إضافية", "default": "يرجى إبقاء هاتفك متاحاً لاستقبال مكالمة التأكيد خلال 24 ساعة." },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "رقم واتساب",
      "info": "بصيغة دولية بدون + أو مسافات، مثل 218910000000",
      "default": "218910000000"
    },
    { "type": "text", "id": "whatsapp_label", "label": "نص زر واتساب", "default": "تواصل معنا على واتساب" },
    { "type": "text", "id": "continue_label", "label": "نص زر المتابعة", "default": "العودة للتسوق" },
    { "type": "url", "id": "continue_link", "label": "رابط المتابعة" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "نظام الألوان",
      "default": "scheme-1"
    },
    { "type": "range", "id": "padding_top", "label": "هامش علوي", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "هامش سفلي", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "Quraan · شكراً" }
  ]
}
{% endschema %}
