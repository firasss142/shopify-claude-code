{{ 'section-quraan-testimonials.css' | asset_url | stylesheet_tag }}

<section
  class="quraan-testimonials color-{{ section.settings.color_scheme }}"
  style="--quraan-testimonials-padding-top: {{ section.settings.padding_top }}px; --quraan-testimonials-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="quraan-testimonials__inner">
    <header class="quraan-testimonials__header">
      <h2 class="quraan-testimonials__heading">{{ section.settings.heading }}</h2>
    </header>

    <ul class="quraan-testimonials__grid" role="list">
      {% for i in (1..3) %}
        {% assign quote_key = 't' | append: i | append: '_quote' %}
        {% assign name_key = 't' | append: i | append: '_name' %}
        {% assign quote = section.settings[quote_key] %}
        {% assign name = section.settings[name_key] %}
        {% if quote != blank %}
          <li class="quraan-testimonials__card">
            <div class="quraan-testimonials__quote-mark" aria-hidden="true">❝</div>
            <blockquote class="quraan-testimonials__quote">{{ quote }}</blockquote>
            <cite class="quraan-testimonials__name">— {{ name }}</cite>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Quraan · آراء العملاء",
  "tag": "section",
  "class": "quraan-testimonials-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "ماذا قال عملاؤنا" },
    { "type": "header", "content": "رأي 1" },
    { "type": "textarea", "id": "t1_quote", "label": "النص", "default": "وصلني المصحف بحالة ممتازة، التجليد قوي والورق رائع. سعدت جداً بالشراء." },
    { "type": "text", "id": "t1_name", "label": "الاسم والمدينة", "default": "أحمد - طرابلس" },
    { "type": "header", "content": "رأي 2" },
    { "type": "textarea", "id": "t2_quote", "label": "النص", "default": "أجمل هدية قدمتها لوالدتي. التذهيب على الغلاف رائع، والخط واضح بشكل مريح." },
    { "type": "text", "id": "t2_name", "label": "الاسم والمدينة", "default": "فاطمة - بنغازي" },
    { "type": "header", "content": "رأي 3" },
    { "type": "textarea", "id": "t3_quote", "label": "النص", "default": "الدفع عند الاستلام أراحني، والشحن وصل أسرع مما توقعت. أنصح به بشدة." },
    { "type": "text", "id": "t3_name", "label": "الاسم والمدينة", "default": "محمد - مصراتة" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "نظام الألوان",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "هامش علوي",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "هامش سفلي",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    { "name": "Quraan · آراء العملاء" }
  ]
}
{% endschema %}
