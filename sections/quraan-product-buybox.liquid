{{ 'quraan-rtl.css' | asset_url | stylesheet_tag }}
{{ 'section-quraan-product-buybox.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quraan-buybox.js' | asset_url }}" defer></script>

{%- liquid
  assign product = section.settings.product | default: closest.product
  assign default_variant = product.selected_or_first_available_variant
  assign unit_price = default_variant.price | default: 0
  assign unit_compare = default_variant.compare_at_price | default: unit_price
  assign has_product = false
  if product != blank and default_variant != blank and default_variant.id != blank
    assign has_product = true
  endif

  # The merchant enters bundle prices in the major unit (e.g. 80 LYD). Shopify stores
  # all prices in the currency's MINOR unit, so we must scale up by 10^(decimal places).
  # That count is currency-dependent: TND/LYD have 3 decimals, USD/EUR 2, JPY 0 — a
  # hardcoded ×100 corrupts any non-2-decimal currency. Default to 2 for anything unlisted.
  assign currency_code = cart.currency.iso_code | default: shop.currency
  assign currency_minor_units = 100
  case currency_code
    when 'TND', 'LYD', 'BHD', 'IQD', 'JOD', 'KWD', 'OMR'
      assign currency_minor_units = 1000
    when 'JPY', 'KRW', 'VND', 'CLP', 'ISK'
      assign currency_minor_units = 1
  endcase

  # Each bundle tier: quantity × per-tier price override. If override is blank/0, fall back to unit_price × qty.
  assign b1_qty = section.settings.bundle_1_quantity | default: 1
  assign b2_qty = section.settings.bundle_2_quantity | default: 2
  assign b3_qty = section.settings.bundle_3_quantity | default: 3

  assign b1_price = section.settings.bundle_1_price | times: currency_minor_units
  if b1_price == 0
    assign b1_price = unit_price | times: b1_qty
  endif
  assign b2_price = section.settings.bundle_2_price | times: currency_minor_units
  if b2_price == 0
    assign b2_price = unit_price | times: b2_qty
  endif
  assign b3_price = section.settings.bundle_3_price | times: currency_minor_units
  if b3_price == 0
    assign b3_price = unit_price | times: b3_qty
  endif

  assign b1_compare = unit_compare | times: b1_qty
  assign b2_compare = unit_compare | times: b2_qty
  assign b3_compare = unit_compare | times: b3_qty

  # Each entry: "<dexpress_id>:<route_id>:<arabic_name>" — sourced from dexpress-states.json
  assign cities = '62:12:طرابلس|10:15:بنغازي|6:1:مصراتة|80:10:سرت|40:7:سبها|52:4:البيضاء|53:4:طبرق|13:3:الزاوية|7:1:زليتن|15:3:صبراتة|8:1:الخمس|20:3:زوارة|55:4:درنة|51:16:اجدابيا|49:8:ترهونة|82:9:بني وليد|32:6:غريان|1:2:هون|2:2:ودان|3:2:سوكنة|4:2:زلة|5:2:الفقهاء|9:1:قصر خيار|11:1:غوط الرمان|12:1:وادي كعام|14:3:صرمان|16:3:زلطن|17:3:الجميل|18:3:ابوكماش|19:3:رقدالين|21:3:راس جدير|22:3:العجيلات|23:5:الزنتان|24:5:الرجبان|25:5:الرياينة|26:5:كاباو|27:5:نالوت|28:5:طمزين|29:5:جادو|30:5:العوينية|31:5:الرحيبات|33:6:الاصابعة|34:16:راس لانوف|35:16:البريقة|36:11:بن جواد|37:16:السدرة /راس لانوف|38:11:العقيلة|39:11:هراوة|41:7:براك الشاطيء|42:7:الشويرف|43:7:اوباري|44:7:مرزق|45:7:غات|46:7:القطرون|47:7:ام الارانب|48:7:الغريفة|50:1:مسلاتة|54:4:المرج|56:17:جالو|57:17:اوجلة|58:17:الكفرة|59:17:تازربو|60:4:الرجمة|61:4:البياضة|63:4:سلوق|64:16:قمينس|65:4:شحات|66:4:الابرق|67:4:سوسة|68:4:التميمي|69:17:اجخرة|70:4:توكرة|71:4:قصر ليبيا|72:4:مسة|73:16:المقرون|74:4:دريانة|75:4:القبة|76:8:سوق الخميس امسيحل|77:8:اسبيعة|78:7:مزدة|79:7:نسمة|81:4:الابيار|83:4:امساعد|84:1:العلوص|85:1:القربوللي|86:1:القويعة|87:1:قماطه|88:3:ابوعيسي|89:3:الماية|90:3:المطرد|91:5:تيجي|92:3:جدائم|93:3:كوبري 27|94:3:الطويلة|95:8:قصر بن غشير|96:8:السايح|97:8:سوق السبت|98:10:ابوقرين|99:6:الرابطة|100:5:يفرن|101:5:الجوش|102:5:بدر|103:5:القلعة|104:5:الجبل الغربي|105:12:السبعة|106:12:الهضبة طول|107:12:السراج|108:12:الترسانة|109:12:جنزور|110:12:حي الاندلس|111:12:تاجوراء|112:7:الشقيقة|113:8:سبيعة|114:13:الناصرية|115:5:وازن|116:7:تراغن|117:18:ضواحي طرابلس (15)|118:15:سيدي خليفة|122:13:ورشفانه|123:21:غدامس|124:22:مكتب طرابلس|125:23:مكتب سبها|126:24:سيدي السايح|127:12:بوستة|128:2:الجفرة' | split: '|'
-%}

<section
  class="quraan-buybox color-{{ section.settings.color_scheme }}"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-default-variant-id="{{ default_variant.id }}"
  data-has-product="{{ has_product }}"
  data-webhook-url="{{ section.settings.webhook_url | escape }}"
  data-success-url="{{ section.settings.success_url | default: '/pages/thank-you' | escape }}"
  style="--quraan-buybox-padding-top: {{ section.settings.padding_top }}px; --quraan-buybox-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- if has_product == false and request.design_mode -%}
    <div style="background:#8B1C1C;color:#F2E8D0;padding:16px;text-align:center;font-family:sans-serif;">
      ⚠️ لم يتم تحديد منتج لهذا القسم. افتح إعدادات القسم واختر المنتج من قائمة <strong>"المنتج"</strong>.
    </div>
  {%- endif -%}

  <div class="quraan-buybox__inner">

    {%- comment -%} ===== Gallery ===== {%- endcomment -%}
    <div class="quraan-buybox__gallery">
      {%- if product.media.size > 0 -%}
        <div class="quraan-buybox__main-image" id="quraan-main-image">
          {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'quraan-buybox__image', alt: product.title }}
        </div>
        {%- if product.media.size > 1 -%}
          <ul class="quraan-buybox__thumbs" role="list">
            {%- for media in product.media limit: 6 -%}
              <li class="quraan-buybox__thumb-item">
                <button
                  type="button"
                  class="quraan-buybox__thumb {% if forloop.first %}is-active{% endif %}"
                  data-image-src="{{ media.preview_image | image_url: width: 1200 }}"
                  data-image-alt="{{ media.alt | default: product.title | escape }}"
                  aria-label="{{ 'accessibility.show_product_details' | t: product_name: product.title }}"
                >
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- else -%}
        <div class="quraan-buybox__main-image quraan-buybox__main-image--placeholder">
          {{ 'product-apparel-1' | placeholder_svg_tag: 'quraan-buybox__image' }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ===== Content column ===== {%- endcomment -%}
    <div class="quraan-buybox__content">

      <h1 class="quraan-buybox__title">{{ product.title | default: section.settings.fallback_title }}</h1>

      {%- if section.settings.show_rating -%}
        <div class="quraan-buybox__rating" aria-label="{{ 'accessibility.rating' | t: rating: section.settings.rating_value }}">
          <span class="quraan-buybox__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- endfor -%}
          </span>
          <span class="quraan-buybox__rating-count">({{ section.settings.review_count }} {{ section.settings.review_label }})</span>
        </div>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <div class="quraan-buybox__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}

      {%- comment -%} ===== Trust row ===== {%- endcomment -%}
      <ul class="quraan-buybox__trust" role="list">
        <li class="quraan-buybox__trust-item">
          <span class="quraan-buybox__trust-icon" aria-hidden="true">📖</span>
          <span>{{ section.settings.trust_1 }}</span>
        </li>
        <li class="quraan-buybox__trust-item">
          <span class="quraan-buybox__trust-icon" aria-hidden="true">✨</span>
          <span>{{ section.settings.trust_2 }}</span>
        </li>
        <li class="quraan-buybox__trust-item">
          <span class="quraan-buybox__trust-icon" aria-hidden="true">🛡️</span>
          <span>{{ section.settings.trust_3 }}</span>
        </li>
        <li class="quraan-buybox__trust-item">
          <span class="quraan-buybox__trust-icon" aria-hidden="true">🚚</span>
          <span>{{ section.settings.trust_4 }}</span>
        </li>
      </ul>

      {%- comment -%} ===== Bundle picker ===== {%- endcomment -%}
      <div class="quraan-buybox__bundles">
        <h2 class="quraan-buybox__bundles-heading">{{ section.settings.bundles_heading }}</h2>

        <fieldset class="quraan-buybox__bundle-list">
          <legend class="visually-hidden">{{ section.settings.bundles_heading }}</legend>

          <label class="quraan-buybox__bundle {% if default_variant.available == false %}is-unavailable{% endif %}">
            <input
              type="radio"
              name="quraan_bundle"
              value="{{ default_variant.id }}"
              data-quantity="{{ b1_qty }}"
              data-price="{{ b1_price }}"
              data-compare-at="{{ b1_compare }}"
              {% if default_variant.available == false %}disabled{% endif %}
              checked
            >
            <span class="quraan-buybox__bundle-card">
              <span class="quraan-buybox__bundle-label">{{ section.settings.bundle_1_label }}</span>
              {%- if section.settings.bundle_1_badge != blank -%}
                <span class="quraan-buybox__bundle-badge">{{ section.settings.bundle_1_badge }}</span>
              {%- endif -%}
              <span class="quraan-buybox__bundle-prices">
                {%- if b1_compare > b1_price -%}
                  <s class="quraan-buybox__bundle-compare">{{ b1_compare | money }}</s>
                {%- endif -%}
                <strong class="quraan-buybox__bundle-price">{{ b1_price | money }}</strong>
              </span>
            </span>
          </label>

          <label class="quraan-buybox__bundle {% if default_variant.available == false %}is-unavailable{% endif %}">
            <input
              type="radio"
              name="quraan_bundle"
              value="{{ default_variant.id }}"
              data-quantity="{{ b2_qty }}"
              data-price="{{ b2_price }}"
              data-compare-at="{{ b2_compare }}"
              {% if default_variant.available == false %}disabled{% endif %}
            >
            <span class="quraan-buybox__bundle-card">
              <span class="quraan-buybox__bundle-label">{{ section.settings.bundle_2_label }}</span>
              {%- if section.settings.bundle_2_badge != blank -%}
                <span class="quraan-buybox__bundle-badge">{{ section.settings.bundle_2_badge }}</span>
              {%- endif -%}
              <span class="quraan-buybox__bundle-prices">
                {%- if b2_compare > b2_price -%}
                  <s class="quraan-buybox__bundle-compare">{{ b2_compare | money }}</s>
                {%- endif -%}
                <strong class="quraan-buybox__bundle-price">{{ b2_price | money }}</strong>
              </span>
            </span>
          </label>

          <label class="quraan-buybox__bundle quraan-buybox__bundle--featured {% if default_variant.available == false %}is-unavailable{% endif %}">
            <input
              type="radio"
              name="quraan_bundle"
              value="{{ default_variant.id }}"
              data-quantity="{{ b3_qty }}"
              data-price="{{ b3_price }}"
              data-compare-at="{{ b3_compare }}"
              {% if default_variant.available == false %}disabled{% endif %}
            >
            <span class="quraan-buybox__bundle-card">
              <span class="quraan-buybox__bundle-label">{{ section.settings.bundle_3_label }}</span>
              {%- if section.settings.bundle_3_badge != blank -%}
                <span class="quraan-buybox__bundle-badge">{{ section.settings.bundle_3_badge }}</span>
              {%- endif -%}
              <span class="quraan-buybox__bundle-prices">
                {%- if b3_compare > b3_price -%}
                  <s class="quraan-buybox__bundle-compare">{{ b3_compare | money }}</s>
                {%- endif -%}
                <strong class="quraan-buybox__bundle-price">{{ b3_price | money }}</strong>
              </span>
            </span>
          </label>
        </fieldset>

        {%- comment -%} ===== Live summary ===== {%- endcomment -%}
        <dl class="quraan-buybox__summary">
          <div class="quraan-buybox__summary-row">
            <dt>{{ section.settings.summary_subtotal_label }}</dt>
            <dd data-buybox-subtotal>{{ b1_compare | money }}</dd>
          </div>
          <div class="quraan-buybox__summary-row" data-buybox-discount-row {% if b1_compare <= b1_price %}hidden{% endif %}>
            <dt>{{ section.settings.summary_discount_label }}</dt>
            <dd data-buybox-discount class="quraan-buybox__summary-discount">
              {%- assign discount = b1_compare | minus: b1_price -%}
              -{{ discount | money }}
            </dd>
          </div>
          <div class="quraan-buybox__summary-row">
            <dt>{{ section.settings.summary_shipping_label }}</dt>
            <dd data-buybox-shipping>{{ section.settings.summary_shipping_value }}</dd>
          </div>
          <div class="quraan-buybox__summary-row quraan-buybox__summary-row--total">
            <dt>{{ section.settings.summary_total_label }}</dt>
            <dd data-buybox-total>{{ b1_price | money }}</dd>
          </div>
        </dl>
      </div>

      {%- comment -%} ===== Order form ===== {%- endcomment -%}
      <form
        class="quraan-buybox__form"
        id="quraan-buybox-form"
        novalidate
      >
        <p class="quraan-buybox__form-heading">📝 {{ section.settings.form_heading }}</p>

        <div class="quraan-buybox__field">
          <label for="quraan-name">{{ section.settings.label_name }}<span aria-hidden="true">*</span></label>
          <input id="quraan-name" name="name" type="text" required autocomplete="name" placeholder="{{ section.settings.label_name }}">
        </div>

        <div class="quraan-buybox__field">
          <label for="quraan-phone">{{ section.settings.label_phone }}<span aria-hidden="true">*</span></label>
          <input id="quraan-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="091XXXXXXX">
        </div>

        <div class="quraan-buybox__field">
          <label for="quraan-city">{{ section.settings.label_city }}<span aria-hidden="true">*</span></label>
          <select id="quraan-city" name="city" required>
            <option value="" disabled selected>{{ section.settings.label_city_placeholder }}</option>
            {%- for city in cities -%}
              {%- assign city_parts = city | split: ':' -%}
              {%- assign city_id = city_parts[0] -%}
              {%- assign city_route = city_parts[1] -%}
              {%- assign city_name = city_parts[2] -%}
              <option value="{{ city_id }}" data-route-id="{{ city_route }}" data-city-name="{{ city_name | escape }}">{{ city_name }}</option>
            {%- endfor -%}
          </select>
        </div>

        <div class="quraan-buybox__field">
          <label for="quraan-address">{{ section.settings.label_address }}<span aria-hidden="true">*</span></label>
          <input id="quraan-address" name="address" type="text" required autocomplete="street-address" placeholder="{{ section.settings.label_address }}">
        </div>

        {%- comment -%} ===== Upsells ===== {%- endcomment -%}
        {%- assign upsell_count = 0 -%}
        {%- for i in (1..4) -%}
          {%- assign key = 'upsell_product_' | append: i -%}
          {%- if section.settings[key] != blank -%}
            {%- assign upsell_count = upsell_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if upsell_count > 0 -%}
          <div class="quraan-buybox__upsells">
            {%- for i in (1..4) -%}
              {%- assign key = 'upsell_product_' | append: i -%}
              {%- assign discount_key = 'upsell_discount_' | append: i -%}
              {%- assign label_key = 'upsell_label_' | append: i -%}
              {%- assign up_product = section.settings[key] -%}
              {%- assign up_discount = section.settings[discount_key] -%}
              {%- assign up_label = section.settings[label_key] -%}

              {%- if up_product != blank -%}
                {%- assign up_variant = up_product.selected_or_first_available_variant -%}
                <label class="quraan-buybox__upsell">
                  <input
                    type="checkbox"
                    class="quraan-buybox__upsell-check"
                    data-variant-id="{{ up_variant.id }}"
                  >
                  {%- if up_product.featured_image != blank -%}
                    {{ up_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'quraan-buybox__upsell-image', alt: up_product.title }}
                  {%- endif -%}
                  <span class="quraan-buybox__upsell-body">
                    <span class="quraan-buybox__upsell-title">
                      🔥 {{ up_label | default: up_product.title }}
                      {%- if up_discount != blank and up_discount > 0 -%}
                        <span class="quraan-buybox__upsell-discount">{{ up_discount }}% خصم</span>
                      {%- endif -%}
                    </span>
                    <span class="quraan-buybox__upsell-prices">
                      <strong>{{ up_variant.price | money }}</strong>
                      {%- if up_variant.compare_at_price > up_variant.price -%}
                        <s>{{ up_variant.compare_at_price | money }}</s>
                      {%- endif -%}
                    </span>
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <button type="submit" class="quraan-buybox__submit">
          🛒 {{ section.settings.submit_label }}
        </button>

        <p class="quraan-buybox__form-error" data-buybox-error hidden></p>

        {%- if section.settings.purchases_pill != blank -%}
          <p class="quraan-buybox__purchases-pill">✅ {{ section.settings.purchases_pill }}</p>
        {%- endif -%}
      </form>

      {%- comment -%} ===== Info accordions ===== {%- endcomment -%}
      <div class="quraan-buybox__accordions">
        {%- if section.settings.acc_1_body != blank -%}
          <details class="quraan-buybox__accordion">
            <summary>
              <span aria-hidden="true">❓</span>
              {{ section.settings.acc_1_title }}
              <span class="quraan-buybox__accordion-icon" aria-hidden="true">+</span>
            </summary>
            <div class="quraan-buybox__accordion-body">{{ section.settings.acc_1_body }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.acc_2_body != blank -%}
          <details class="quraan-buybox__accordion">
            <summary>
              <span aria-hidden="true">⭐</span>
              {{ section.settings.acc_2_title }}
              <span class="quraan-buybox__accordion-icon" aria-hidden="true">+</span>
            </summary>
            <div class="quraan-buybox__accordion-body">{{ section.settings.acc_2_body }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.acc_3_body != blank -%}
          <details class="quraan-buybox__accordion">
            <summary>
              <span aria-hidden="true">📋</span>
              {{ section.settings.acc_3_title }}
              <span class="quraan-buybox__accordion-icon" aria-hidden="true">+</span>
            </summary>
            <div class="quraan-buybox__accordion-body">{{ section.settings.acc_3_body }}</div>
          </details>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- if section.settings.enable_sticky_cta -%}
    <a class="quraan-buybox__sticky-cta" href="#quraan-buybox-form">
      🛒 {{ section.settings.submit_label }}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Quraan · المنتج",
  "tag": "section",
  "class": "quraan-buybox-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "header", "content": "المنتج" },
    {
      "type": "product",
      "id": "product",
      "label": "المنتج (اختياري)",
      "info": "اتركه فارغاً لاستخدام المنتج الحالي تلقائياً."
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "عنوان احتياطي",
      "default": "المصحف الشريف",
      "info": "يظهر فقط في حال لم يتم تحديد منتج."
    },

    { "type": "header", "content": "التقييم" },
    { "type": "checkbox", "id": "show_rating", "label": "إظهار النجوم", "default": true },
    { "type": "text", "id": "rating_value", "label": "قيمة التقييم", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "عدد التقييمات", "default": "1349" },
    { "type": "text", "id": "review_label", "label": "كلمة \"تقييم\"", "default": "تقييم" },

    { "type": "header", "content": "الوصف" },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "وصف قصير",
      "default": "<p>مصحف يَجمع بين روحانية المخطوطات الأندلسية ودقّة الطباعة الحديثة، ليكون رفيق تلاوتك اليومية.</p>"
    },

